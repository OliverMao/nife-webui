{
	"compilerOptions": {
		"target": "ES2024",
		"module": "Node16",
		"moduleResolution": "Node16",
		"lib": [
			"ES2024"
		],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": [
			"node"
		],
		"typeRoots": [
			"../nife/node_modules/@types"
		],
		"paths": {
			"nife-coding-agent": [
				"../nife/packages/coding-agent/src/index.ts"
			]
		},
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true
	},
	"include": [
		"extensions/**/*.ts"
	]
}